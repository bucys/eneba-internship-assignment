{
  "tool": "vitest",
  "gate": null,
  "additionalTools": [],
  "e2eTool": "none",
  "testDir": "beside the source",
  "filePattern": "*.test.{ts,tsx}",
  "packageManager": "npm",
  "packages": {
    "client": {
      "tool": "vitest",
      "additionalTools": [],
      "testDir": "beside the source",
